# Copy this file to .env.local. Never commit real keys or passwords.
# Chat Completions-compatible API. Model name must exist at your chosen service.
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=
AI_MODEL=your-model-name

# Existing Nextcloud with Calendar and Talk installed.
NEXTCLOUD_URL=http://127.0.0.1:8080
NEXTCLOUD_BROWSER_URL=http://localhost:8080
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_CALENDAR=personal

# Set true before exposing the app publicly. Each user signs in to their own Nextcloud.
APP_AUTH_REQUIRED=false
# Required for account login: generate with node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
